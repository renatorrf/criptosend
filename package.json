{
  "name": "cripto-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "secrets:prepare": "tsx src/cli/prepare-local-secrets.ts",
    "env:cloud:prepare": "tsx src/cli/prepare-cloud-env.ts",
    "env:cloud:check": "tsx src/cli/prepare-cloud-env.ts --check",
    "env:remove-legacy-sms": "tsx src/cli/remove-legacy-sms-env.ts",
    "admin:approve-reset": "tsx src/cli/approve-account-reset.ts",
    "admin:bootstrap": "tsx src/cli/bootstrap-platform-admin.ts",
    "admin:migrate-phone-user": "tsx src/cli/migrate-phone-user.ts",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:rollback": "tsx src/database/cli.ts rollback",
    "db:verify": "tsx src/database/cli.ts verify"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}

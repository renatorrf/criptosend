NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/criptsend
SCHEMA=criptsend
APP_ORIGINS=http://localhost:8100
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Required by later identity and encryption phases. Generate unique values
# outside source control before those features are enabled.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=
PHONE_LOOKUP_SECRET=
VERIFICATION_CODE_SECRET=
CONVERSATION_KEY_SECRET=

AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=criptsend_refresh
AUTH_COOKIE_SECURE=false
VERIFICATION_TTL_SECONDS=600
PHONE_DEFAULT_COUNTRY=BR

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Optional HTTPS endpoint that sends { phone, code } to the SMS provider.
PHONE_VERIFICATION_WEBHOOK_URL=
PHONE_VERIFICATION_WEBHOOK_TOKEN=

# Optional static STUN/ICE entries consumed by RTCPeerConnection.
RTC_ICE_SERVERS_JSON=[]
# Production requires the dynamic TURN settings below. The API derives
# short-lived credentials from the Coturn REST secret without returning it.
RTC_TURN_URLS=
RTC_TURN_SHARED_SECRET=
RTC_TURN_CREDENTIAL_TTL_SECONDS=3600
RTC_RING_TIMEOUT_SECONDS=45
